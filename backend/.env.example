# ==============================================================================
# CommitRush Backend - Production Environment Variables Template
# ==============================================================================

# Core Django Settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-secure-50-char-random-secret-key-in-production
DJANGO_ALLOWED_HOSTS=commitrush.hackit.org,api.commitrush.hackit.org,127.0.0.1,localhost

# Database Configuration (Neon PostgreSQL)
# Provide the authoritative Neon PostgreSQL connection string:
# Direct endpoint is recommended for running migrations; pooled endpoint can be used for web workers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
USE_SQLITE=False
DB_SSLMODE=require

# Alternatively, individual DB_* parameters can be specified:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=DBNAME
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_HOST=HOST
DB_PORT=5432
DB_CONN_MAX_AGE=600
DB_CONN_HEALTH_CHECKS=True

# Caching & Celery (Redis)
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# GitHub Integration
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_REDIRECT_URI=https://commitrush.hackit.org/auth/github/callback/
GITHUB_OAUTH_SCOPE=read:user
# Optional: Only required if GitHub REST issue synchronization or automated merge bot is run at runtime
# GITHUB_API_TOKEN=your-github-rest-api-service-token
GITHUB_WEBHOOK_SECRET=your-github-webhook-shared-secret

# Frontend & Cross-Origin Configuration
FRONTEND_URL=https://commitrush.hackit.org
FRONTEND_AUTH_REDIRECT_URL=https://commitrush.hackit.org/profile
CORS_ALLOWED_ORIGINS=https://commitrush.hackit.org
CSRF_TRUSTED_ORIGINS=https://commitrush.hackit.org

# Security & Cookies (Production defaults to True when DJANGO_DEBUG=False)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Logging
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
